generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  password            String
  isActive            Boolean            @default(true)
  isVerified          Boolean            @default(true)
  role                UserRole           @default(EMPLOYEE)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  avatar              String?
  department          String?
  designation         String?
  failedLoginAttempts Int                @default(0)
  isLocked            Boolean            @default(false)
  lastLogin           DateTime?
  lockedUntil         DateTime?
  name                String?
  passwordHistory     Json?
  passwordVersion     Int                @default(1)
  userType            UserType           @default(EMPLOYEE)
  employeeId          String?            @unique
  joiningDate         DateTime?
  phone               String?
  customViews         CustomView[]
  departmentMembers   DepartmentMember[]
  notes               Note[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  savedFilters        SavedFilter[]
  sessions            Session[]
  assignedTasks       Task[]             @relation("TaskAssignee")
  createdTasks        Task[]             @relation("TaskCreator")
  comments            TaskComment[]
  taskWatchers        TaskWatcher[]
  timeEntries         TimeEntry[]

  @@index([email])
  @@index([role])
  @@index([userType])
}

model Session {
  id            String         @id @default(uuid())
  userId        String
  token         String         @unique
  refreshToken  String?
  device        String?
  browser       String?
  os            String?
  ipAddress     String?
  userAgent     String?
  loginAt       DateTime       @default(now())
  lastActivity  DateTime       @default(now())
  expiresAt     DateTime
  idleExpiresAt DateTime
  isRevoked     Boolean        @default(false)
  revokedAt     DateTime?
  isRememberMe  Boolean        @default(false)
  refreshTokens RefreshToken[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, isRevoked])
  @@index([expiresAt])
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique
  sessionId           String
  userId              String
  expiresAt           DateTime
  isRevoked           Boolean   @default(false)
  revokedAt           DateTime?
  replacedByTokenHash String?
  session             Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([sessionId])
  @@index([userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  sessionId  String?
  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model LoginAttempt {
  id            String    @id @default(uuid())
  email         String
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([email, createdAt])
}

model Task {
  id                String            @id @default(uuid())
  taskId            Int               @unique @default(autoincrement())
  title             String
  description       String?
  assignedUserId    String?
  assignedUserName  String?
  createdById       String
  createdByName     String
  startDate         DateTime?
  dueDate           DateTime?
  reminderDate      DateTime?
  completedAt       DateTime?
  verifiedAt        DateTime?
  closedAt          DateTime?
  priority          TaskPriority      @default(Medium)
  category          TaskCategory?
  progress          Int               @default(0)
  estimatedHours    Decimal?
  timeSpent         Decimal?
  verifiedByName    String?
  notes             String?
  internalNotes     String?
  tags              String[]
  createdById_field String?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?
  deletedById       String?
  archivedAt        DateTime?
  isArchived        Boolean           @default(false)
  parentTaskId      String?
  slaBreached       Boolean           @default(false)
  slaDueDate        DateTime?
  assignedById      String?
  assignedByName    String?
  completedById     String?
  completedByName   String?
  isFavorite        Boolean           @default(false)
  isPinned          Boolean           @default(false)
  updatedById       String?
  verifiedById      String?
  status            TaskStatus        @default(Todo)
  startedAt         DateTime?
  assignee          User?             @relation("TaskAssignee", fields: [assignedUserId], references: [id])
  creator           User              @relation("TaskCreator", fields: [createdById], references: [id])
  parentTask        Task?             @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks          Task[]            @relation("Subtasks")
  activities        TaskActivityLog[]
  attachments       TaskAttachment[]
  checklist         TaskChecklist[]
  comments          TaskComment[]
  dependencies      TaskDependency[]
  labels            TaskLabel[]
  watchers          TaskWatcher[]
  timeEntries       TimeEntry[]

  @@index([status])
  @@index([priority])
  @@index([assignedUserId])
  @@index([createdById])
  @@index([parentTaskId])
  @@index([dueDate])
  @@index([isDeleted])
  @@index([isArchived])
  @@index([isPinned])
  @@index([isFavorite])
}

model TaskChecklist {
  id          String    @id @default(uuid())
  taskId      String
  text        String
  completed   Boolean   @default(false)
  completedAt DateTime?
  completedBy String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id         String   @id @default(uuid())
  taskId     String
  content    String
  authorId   String
  authorName String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false)
  mentions   String[]
  author     User     @relation(fields: [authorId], references: [id])
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
}

model TaskAttachment {
  id             String   @id @default(uuid())
  taskId         String
  fileName       String
  fileType       String
  fileSize       Int
  fileUrl        String
  uploadedBy     String
  uploadedByName String
  description    String?
  createdAt      DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  relationship    String   @default("Depends On")
  createdAt       DateTime @default(now())
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([dependsOnTaskId])
}

model TaskActivityLog {
  id              String   @id @default(uuid())
  taskId          String
  activityType    String
  description     String
  performedBy     String
  performedByName String
  metadata        Json?
  createdAt       DateTime @default(now())
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
}

model Label {
  id        String      @id @default(uuid())
  name      String      @unique
  color     String      @default("#3ABEFF")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tasks     TaskLabel[]
}

model TaskLabel {
  id      String @id @default(uuid())
  taskId  String
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
}

model TaskWatcher {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TimeEntry {
  id          String    @id @default(uuid())
  taskId      String
  userId      String
  description String?
  startedAt   DateTime
  endedAt     DateTime?
  duration    Float?
  createdAt   DateTime  @default(now())
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([userId, startedAt])
}

model Department {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  managerId   String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  isDeleted   Boolean            @default(false)
  members     DepartmentMember[]
}

model DepartmentMember {
  id           String     @id @default(uuid())
  departmentId String
  userId       String
  role         String     @default("member")
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([departmentId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  taskId    String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model SavedFilter {
  id        String   @id @default(uuid())
  userId    String
  name      String
  filters   Json
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CustomView {
  id        String   @id @default(uuid())
  userId    String
  name      String
  viewType  String
  filters   Json
  sortBy    String?
  sortOrder String?  @default("desc")
  columns   Json?
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AutomationRule {
  id         String    @id @default(uuid())
  name       String
  trigger    String
  conditions Json
  actions    Json
  isActive   Boolean   @default(true)
  runCount   Int       @default(0)
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive])
}

model TaskTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  defaults    Json
  createdById String
  useCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityFeed {
  id              String   @id @default(uuid())
  entityType      String
  entityId        String
  activityType    String
  description     String
  performedBy     String
  performedByName String
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([performedBy])
}

model Note {
  id          String    @id @default(uuid())
  title       String
  content     String?
  folder      String    @default("/")
  tags        String[]
  isPinned    Boolean   @default(false)
  isArchived  Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  creator     User      @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([folder])
  @@index([isPinned])
  @@index([isDeleted])
}

model AppVersion {
  id                     String   @id @default(uuid())
  versionName            String
  versionCode            Int
  platform               String
  fileName               String
  apkData                Bytes?
  fileSize               Int
  fileType               String
  releaseNotes           String?
  minimumSupportedVersion String?
  isLatest               Boolean  @default(false)
  isMandatory            Boolean  @default(false)
  isActive               Boolean  @default(true)
  downloadCount          Int      @default(0)
  uploadedBy             String
  uploadedByName         String
  uploadedAt             DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([platform])
  @@index([platform])
  @@index([isLatest])
  @@index([isActive])
  @@index([versionName])
}

enum UserType {
  SUPER_ADMIN
  EMPLOYEE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum TaskStatus {
  Draft
  Todo
  InProgress
  OnHold
  Completed
  Archived
  Cancelled
}

enum TaskPriority {
  None
  Low
  Medium
  High
  Urgent
}

enum TaskCategory {
  General
  Office
  FieldWork
  Maintenance
  Installation
  Inspection
  Documentation
  Meeting
  Training
  Other
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_VERIFIED
  TASK_REJECTED
  COMMENT_ADDED
  MENTION
  STATUS_CHANGED
  DUE_DATE_REMINDER
  SLA_BREACH
}
