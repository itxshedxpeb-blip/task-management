# Copy to .env for local development.
# Production variables are set via environment in the deployment.

# Application
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/task-management?sslmode=disable"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/task-management?sslmode=disable"

# JWT / Cookies
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-a-random-refresh-secret-at-least-32-chars
COOKIE_SECRET=change-this-to-a-random-cookie-secret-at-least-32-chars
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/
COOKIE_REFRESH_NAME=refreshToken
COOKIE_SIGNED=true

# Session
SESSION_ABSOLUTE_DAYS=1
SESSION_REMEMBER_ME_DAYS=30
SESSION_IDLE_MINUTES=120
SESSION_MULTI_DEVICE=false

# Security
BCRYPT_ROUNDS=12
PASSWORD_HISTORY_SIZE=10

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=500
THROTTLE_AUTH_LIMIT=10

# Refresh token reuse grace period (ms)
REFRESH_REUSE_GRACE_MS=10000
