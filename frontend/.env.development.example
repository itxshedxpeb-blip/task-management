# Development Environment Configuration
# Copy this file to .env.development and update with your values

# API Configuration
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_CAPABILITIES_PATH=/system/capabilities
NEXT_PUBLIC_ENVIRONMENT=development

# Backend URL for Next.js rewrites (server-side only)
BACKEND_URL=http://127.0.0.1:8000

# Image hostname for next.config.ts remote patterns (server-side only)
IMAGE_HOSTNAME=localhost

# Capacitor Configuration
NEXT_PUBLIC_CAPACITOR_SERVER_URL=http://10.0.2.2:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CRASH_REPORTING=false
