# Copy to .env.local for local development.
# Production variables are set via environment in the deployment.

# API Configuration
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_CAPABILITIES_PATH=/system/capabilities
NEXT_PUBLIC_ENVIRONMENT=development

# Backend URL for Next.js rewrites (server-side only)
BACKEND_URL=http://localhost:8000

# Backend URL for client-side API calls (required in production)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Image hostname for next.config.ts remote patterns (server-side only)
NEXT_PUBLIC_IMAGE_HOSTNAME=localhost

# Capacitor Configuration
NEXT_PUBLIC_CAPACITOR_SERVER_URL=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CRASH_REPORTING=false
