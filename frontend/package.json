{
    "name": "@task-standalone/web",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "dev": "next dev --webpack --hostname 0.0.0.0 --port 3000",
        "dev:staging": "copy .env.staging .env.local && next dev --webpack -H 0.0.0.0",
        "dev:production": "copy .env.production .env.local && next dev --webpack -H 0.0.0.0",
        "build": "next build --webpack",
        "build:development": "copy .env.development .env.local && next build --webpack",
        "build:staging": "copy .env.staging .env.local && next build --webpack",
        "build:production": "copy .env.production .env.local && next build --webpack",
        "build:capacitor": "next build --webpack",
        "build:capacitor:development": "copy .env.development .env.local && next build --webpack",
        "build:capacitor:staging": "copy .env.staging .env.local && next build --webpack",
        "build:capacitor:production": "copy .env.production .env.local && next build --webpack",
        "cap:sync": "npm run build:capacitor && npx cap sync android",
        "cap:sync:development": "npm run build:capacitor:development && npx cap sync android",
        "cap:sync:staging": "npm run build:capacitor:staging && npx cap sync android",
        "cap:sync:production": "npm run build:capacitor:production && npx cap sync android",
        "cap:open": "npx cap open android",
        "cap:run": "npm run build:capacitor && npx cap sync android && npx cap run android",
        "cap:build:debug": "cd android && gradlew assembleDebug",
        "cap:build:release": "cd android && gradlew assembleRelease",
        "cap:build:aab": "cd android && gradlew bundleRelease",
        "start": "next start",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "type-check": "tsc --noEmit",
        "clean": "rimraf .next out dist .turbo",
        "doctor": "node scripts/doctor.mjs",
        "test:runtime": "node scripts/runtime-check.mjs",
        "test:ui": "playwright test",
        "test:ui:headed": "playwright test --headed",
        "audit:production": "node scripts/production-static-audit.mjs",
        "clean:workers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-node-workers.ps1"
    },
    "dependencies": {
        "@capacitor/android": "^6.0.0",
        "@capacitor/cli": "^6.0.0",
        "@capacitor/core": "^6.0.0",
        "@capacitor/ios": "^6.0.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@radix-ui/react-dialog": "^1.1.17",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.17",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-toast": "^1.2.15",
        "@tanstack/react-query": "^5.100.14",
        "autoprefixer": "^10.4.20",
        "axios": "^1.16.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.21",
        "lucide-react": "^1.17.0",
        "next": "16.2.6",
        "next-pwa": "^5.6.0",
        "postcss": "^8.4.49",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.77.0",
        "recharts": "^3.8.1",
        "socket.io-client": "^4.8.3",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^3.4.17",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@next/bundle-analyzer": "^16.3.0",
        "@playwright/test": "^1.61.1",
        "@types/next-pwa": "^5.6.9",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "cross-env": "^10.1.0",
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "rimraf": "^6.1.3",
        "typescript": "^5"
    }
}
