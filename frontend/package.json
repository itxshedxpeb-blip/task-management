{
    "name": "@task-standalone/web",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22 <23",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "type-check": "tsc --noEmit",
        "clean": "rimraf .next out dist .turbo",
        "doctor": "node scripts/doctor.mjs",
        "test:runtime": "node scripts/runtime-check.mjs",
        "test:ui": "playwright test",
        "test:ui:headed": "playwright test --headed",
        "audit:production": "node scripts/production-static-audit.mjs",
        "clean:workers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-node-workers.ps1"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@radix-ui/react-dialog": "^1.1.17",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.17",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-toast": "^1.2.15",
        "@react-pdf/renderer": "^4.5.1",
        "@tanstack/react-query": "^5.100.14",
        "axios": "^1.16.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "html-to-image": "^1.11.13",
        "js-cookie": "^3.0.8",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "lucide-react": "^1.17.0",
        "next": "16.2.6",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.77.0",
        "recharts": "^3.8.1",
        "tailwind-merge": "^3.6.0",
        "xlsx": "^0.18.5",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@next/bundle-analyzer": "^16.2.9",
        "@playwright/test": "^1.61.1",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "autoprefixer": "^10.4.20",
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "postcss": "^8.4.49",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "rimraf": "^6.1.3",
        "tailwindcss": "^3.4.17",
        "typescript": "^5"
    }
}
