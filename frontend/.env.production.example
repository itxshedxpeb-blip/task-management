# Production Environment Configuration
# Set these as environment variables in Vercel/Render.

NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_CAPABILITIES_PATH=/system/capabilities
NEXT_PUBLIC_BACKEND_URL=https://task-management-backend-v2mh.onrender.com
NEXT_PUBLIC_IMAGE_HOSTNAME=task-management-backend-v2mh.onrender.com
BACKEND_URL=https://task-management-backend-v2mh.onrender.com

# Android/Capacitor: set to deployed frontend URL for API proxying
NEXT_PUBLIC_CAPACITOR_SERVER_URL=https://task-management-w4ai-swart.vercel.app

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CRASH_REPORTING=false
