# Production Environment Configuration
# Copy this file to .env.production and update with your values

# API Configuration
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
NEXT_PUBLIC_CAPABILITIES_PATH=/system/capabilities
NEXT_PUBLIC_ENVIRONMENT=production

# Backend URL for Next.js rewrites (server-side only)
BACKEND_URL=https://api.yourdomain.com

# Image hostname for next.config.ts remote patterns (server-side only)
IMAGE_HOSTNAME=api.yourdomain.com

# Capacitor Configuration (not used in production - app uses bundled assets)
NEXT_PUBLIC_CAPACITOR_SERVER_URL=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CRASH_REPORTING=true
